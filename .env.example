# Copy to .env.production on the server and fill in. Never commit the real file.

# Your domain (point its DNS A record to the VPS IP first) and an email for the HTTPS certificate.
DOMAIN=gsabadminton.in
ACME_EMAIL=you@example.com
APP_URL=https://gsabadminton.in

# First admin sign-in (used once, on the very first start; you must change it after signing in).
# Leave ADMIN_INITIAL_PASSWORD empty to get a random one in /data/FIRST_LOGIN.txt instead.
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=

# Optional: Razorpay (instant UPI-app / QR / card payments, auto-confirmed). Dashboard → Account & Settings → API keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks → https://YOUR-DOMAIN/api/webhooks/razorpay, events payment.captured + order.paid
RAZORPAY_WEBHOOK_SECRET=

# Optional: automatic WhatsApp confirmations (Meta WhatsApp Cloud API). Without these, confirmations
# go out free with one tap from the admin app.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=booking_confirmed
WHATSAPP_TEMPLATE_LANG=en
