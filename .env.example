# Environment variables for the hosting panel (Hostinger: Node.js app → Environment variables).
# Secrets live only there, never in the repository.

# The site's own address.
APP_URL=https://example.com

# Behind the host's HTTPS proxy: lets per-visitor limits see the real visitor address.
TRUST_PROXY=1

# Where the database, photos and bills are kept. Must be outside the app folder, which is replaced
# on every deployment. Leave unset to use ~/gsa-data in the hosting account's home folder.
# DATA_DIR=/home/USERNAME/gsa-data

# First admin sign-in (used once, on the very first start; you must change it after signing in).
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=

# Optional: hides Node's notice that its built-in SQLite is experimental.
NODE_OPTIONS=--disable-warning=ExperimentalWarning

# Optional: Razorpay (instant UPI-app / QR / card payments, auto-confirmed). Dashboard → Account & Settings → API keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks → https://YOUR-DOMAIN/api/webhooks/razorpay, events payment.captured + order.paid
RAZORPAY_WEBHOOK_SECRET=
